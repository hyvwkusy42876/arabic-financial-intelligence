# =====================================================
# ARABIC FINANCIAL INTELLIGENCE PLATFORM
# Environment Configuration Template
# =====================================================

# =====================================================
# AI PROVIDER CONFIGURATION
# =====================================================
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.2-q4_K_M
OLLAMA_TIMEOUT=120

# Future: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4

# =====================================================
# MARKET DATA PROVIDER CONFIGURATION
# =====================================================
MARKET_DATA_PROVIDER=mock
# MARKET_DATA_PROVIDER=yahoo  # or egx, alpha_vantage

# Yahoo Finance (Optional)
YAHOO_FINANCE_ENABLED=true

# EGX (Egyptian Exchange) - Future
# EGX_API_KEY=your_key_here
# EGX_API_URL=https://api.egx.com.eg

# Alpha Vantage - Future
# ALPHA_VANTAGE_KEY=your_key_here

# =====================================================
# NEWS & RESEARCH PROVIDER CONFIGURATION
# =====================================================
NEWS_PROVIDER=mock
# NEWS_PROVIDER=newsapi  # or finnhub, marketstack

# NewsAPI
# NEWSAPI_KEY=your_key_here
# NEWSAPI_URL=https://newsapi.org/v2

# Finnhub - Future
# FINNHUB_API_KEY=your_key_here

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./afi_data.db
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# =====================================================
# HARDWARE & PERFORMANCE CONFIGURATION
# =====================================================
GPU_ENABLED=true
GPU_DEVICE_ID=0
MAX_VRAM_GB=4
MAX_RAM_GB=12
MAX_CONTEXT_LENGTH=2048
BATCH_SIZE=1

# =====================================================
# CACHING CONFIGURATION
# =====================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MARKET_DATA_TTL=60
CACHE_NEWS_TTL=600

# =====================================================
# BACKTESTING CONFIGURATION
# =====================================================
BACKTEST_MAX_WORKERS=4
BACKTEST_CHUNK_SIZE=252  # Trading days per year

# =====================================================
# PAPER TRADING CONFIGURATION
# =====================================================
PAPER_TRADING_INITIAL_CASH=10000.0
PAPER_TRADING_COMMISSION=0.001  # 0.1%
PAPER_TRADING_SLIPPAGE=0.001  # 0.1%

# =====================================================
# RISK ENGINE CONFIGURATION
# =====================================================
RISK_DEFAULT_MAX_POSITION=0.2  # 20% of portfolio
RISK_DEFAULT_MAX_CONCENTRATION=0.3  # 30% in single sector
RISK_DEFAULT_PORTFOLIO_MAX_RISK=0.05  # 5% total portfolio risk

# =====================================================
# LANGUAGE & LOCALIZATION
# =====================================================
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
